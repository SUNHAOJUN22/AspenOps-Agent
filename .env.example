# Portable first-run backend. Change to aspen_plus or hysys only after configuring real paths.
ASPENOPS_BACKEND=mock
ASPENOPS_MODE=default

# Mock may use an empty allowlist and a repository-local state directory.
ASPENOPS_ALLOWED_ROOTS=
ASPENOPS_STATE_DIR=var/aspenops-state

# Real Aspen example: all entries must be absolute, and state must be inside an allowed root.
# ASPENOPS_BACKEND=aspen_plus
# ASPENOPS_ALLOWED_ROOTS=C:/AspenModels;C:/AspenResults
# ASPENOPS_STATE_DIR=C:/AspenResults/aspenops-state

# Effective concurrency is bounded by both values and by runtime stability/resources.
ASPENOPS_LICENSE_SLOTS=1
ASPENOPS_MAX_WORKERS=1
ASPENOPS_MAX_RESIDENT_CASES=2

# Worker and pool lifecycle.
ASPENOPS_TIMEOUT_S=1200
ASPENOPS_STARTUP_TIMEOUT_S=90
ASPENOPS_WORKER_MAX_POINTS=200
ASPENOPS_WORKER_MAX_AGE_S=14400
ASPENOPS_POOL_IDLE_TIMEOUT_S=1800

# Durable scheduler behavior.
ASPENOPS_SCHEDULER_POLL_S=0.25
ASPENOPS_JOB_LEASE_S=30
ASPENOPS_CANCELLATION_GRACE_S=2
ASPENOPS_JOB_MAX_ATTEMPTS=3

# Fail-closed request and optimization budgets.
ASPENOPS_MAX_REQUEST_BYTES=10000000
ASPENOPS_MAX_BATCH_POINTS=10000
ASPENOPS_MAX_SEMANTIC_OPERATIONS=1000000
ASPENOPS_MAX_OPTIMIZATION_EVALUATIONS=10000
ASPENOPS_MAX_OPTIMIZATION_VARIABLES=64
ASPENOPS_MAX_OPTIMIZATION_OBJECTIVES=16

# Do not cache failures by default. Keep Aspen invisible outside troubleshooting.
ASPENOPS_CACHE_FAILURES=0
ASPENOPS_VISIBLE=0

# Optional explicit COM ProgID pins. Leave unset for newest-first runtime discovery.
# ASPENOPS_PROGID=Apwn.Document.40.0
# ASPENOPS_HYSYS_PROGID=HYSYS.Application

# Licensed certification metadata. Configure only on an approved self-hosted host.
# ASPENOPS_GIT_COMMIT=<exact-approved-40-character-sha>
# ASPENOPS_LICENSE_SERVER_IDENTITY=<non-secret-approved-identifier>
# ASPENOPS_LICENSE_FEATURES=<approved-feature-list>
# ASPENOPS_CERT_SIGNING_KEY=C:/AspenKeys/aspenops-certification-private.pem
# ASPENOPS_CERT_PUBLIC_KEY=C:/AspenKeys/aspenops-certification-public.pem

# Never commit real credentials, private keys, proprietary model paths or license secrets.
