{
  "backend": "mock",
  "model_path": "examples/mock-case.json",
  "registry_path": "examples/node-registry.example.json",
  "workers": 2,
  "reinitialize": true,
  "timeout_s": 30,
  "base_writes": [
    {
      "key": "stream.input.pressure",
      "identifiers": {
        "stream": "FEED"
      },
      "value": 5,
      "unit": "bar"
    },
    {
      "key": "stream.input.mass_flow",
      "identifiers": {
        "stream": "FEED"
      },
      "value": 120,
      "unit": "kg/h"
    },
    {
      "key": "block.input.stages",
      "identifiers": {
        "block": "COL1"
      },
      "value": 28,
      "unit": "1"
    }
  ],
  "points": [
    {
      "writes": [
        {
          "key": "stream.input.temperature",
          "identifiers": {
            "stream": "FEED"
          },
          "value": 70,
          "unit": "C"
        },
        {
          "key": "block.input.reflux_ratio",
          "identifiers": {
            "block": "COL1"
          },
          "value": 1.8,
          "unit": "1"
        }
      ]
    },
    {
      "writes": [
        {
          "key": "stream.input.temperature",
          "identifiers": {
            "stream": "FEED"
          },
          "value": 90,
          "unit": "C"
        },
        {
          "key": "block.input.reflux_ratio",
          "identifiers": {
            "block": "COL1"
          },
          "value": 2.4,
          "unit": "1"
        }
      ]
    },
    {
      "writes": [
        {
          "key": "stream.input.temperature",
          "identifiers": {
            "stream": "FEED"
          },
          "value": 110,
          "unit": "C"
        },
        {
          "key": "block.input.reflux_ratio",
          "identifiers": {
            "block": "COL1"
          },
          "value": 3.0,
          "unit": "1"
        }
      ]
    }
  ],
  "reads": [
    {
      "key": "stream.output.purity",
      "identifiers": {
        "stream": "PRODUCT"
      },
      "unit": "fraction"
    },
    {
      "key": "stream.output.mass_flow",
      "identifiers": {
        "stream": "PRODUCT"
      },
      "unit": "kg/h"
    },
    {
      "key": "block.output.reboiler_duty",
      "identifiers": {
        "block": "COL1"
      },
      "unit": "kW"
    },
    {
      "key": "reactor.output.conversion",
      "identifiers": {
        "block": "R1"
      },
      "unit": "fraction"
    }
  ],
  "metadata": {
    "case": "portable-distillation-demo"
  }
}
