{
  "name": "example-distillation-semantic-registry",
  "version": "1.0.0",
  "nodes": {
    "stream.input.temperature": {
      "backend": "aspen_plus",
      "access": "readwrite",
      "unit": "C",
      "lower": -50,
      "upper": 500,
      "identifiers": ["stream"],
      "paths": [
        "\\Data\\Streams\\{stream}\\Input\\TEMP\\MIXED",
        "\\Data\\Streams\\{stream}\\Input\\TEMP"
      ],
      "locator": {"mock_key": "feed_temperature_C"}
    },
    "stream.input.pressure": {
      "backend": "aspen_plus",
      "access": "readwrite",
      "unit": "bar",
      "lower": 0.01,
      "upper": 500,
      "identifiers": ["stream"],
      "paths": ["\\Data\\Streams\\{stream}\\Input\\PRES\\MIXED"],
      "locator": {"mock_key": "feed_pressure_bar"}
    },
    "stream.input.mass_flow": {
      "backend": "aspen_plus",
      "access": "readwrite",
      "unit": "kg/h",
      "lower": 0,
      "upper": 10000000,
      "identifiers": ["stream"],
      "paths": ["\\Data\\Streams\\{stream}\\Input\\TOTFLOW\\MIXED"],
      "locator": {"mock_key": "feed_flow_kg_h"}
    },
    "block.input.reflux_ratio": {
      "backend": "aspen_plus",
      "access": "readwrite",
      "unit": "1",
      "lower": 0.01,
      "upper": 100,
      "identifiers": ["block"],
      "paths": ["\\Data\\Blocks\\{block}\\Input\\BASIS_RR"],
      "locator": {"mock_key": "reflux_ratio"}
    },
    "block.input.stages": {
      "backend": "aspen_plus",
      "access": "readwrite",
      "unit": "1",
      "integer": true,
      "lower": 2,
      "upper": 300,
      "identifiers": ["block"],
      "paths": ["\\Data\\Blocks\\{block}\\Input\\NSTAGE"],
      "locator": {"mock_key": "stages"}
    },
    "stream.output.purity": {
      "backend": "aspen_plus",
      "access": "read",
      "unit": "fraction",
      "identifiers": ["stream"],
      "paths": ["\\Data\\Streams\\{stream}\\Output\\MOLEFRAC\\MIXED\\PRODUCT"],
      "locator": {"mock_key": "product_purity"}
    },
    "stream.output.mass_flow": {
      "backend": "aspen_plus",
      "access": "read",
      "unit": "kg/h",
      "identifiers": ["stream"],
      "paths": ["\\Data\\Streams\\{stream}\\Output\\MASSFLOW\\MIXED"],
      "locator": {"mock_key": "product_flow_kg_h"}
    },
    "block.output.reboiler_duty": {
      "backend": "aspen_plus",
      "access": "read",
      "unit": "kW",
      "identifiers": ["block"],
      "paths": ["\\Data\\Blocks\\{block}\\Output\\REB_DUTY"],
      "locator": {"mock_key": "reboiler_duty_kW"}
    },
    "reactor.output.conversion": {
      "backend": "aspen_plus",
      "access": "read",
      "unit": "fraction",
      "identifiers": ["block"],
      "paths": ["\\Data\\Blocks\\{block}\\Output\\CONVERSION"],
      "locator": {"mock_key": "conversion"}
    }
  }
}
