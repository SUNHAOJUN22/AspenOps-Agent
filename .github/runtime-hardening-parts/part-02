def _process_pid(process: Any) -> int | None:
    value = getattr(process, "pid", None)
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        return None
    return value


def _capture_descendant_fingerprints(process: Any) -> tuple[ProcessFingerprint, ...]:
    pid = _process_pid(process)
    if pid is None:
        return ()
    try:
        children = psutil.Process(pid).children(recursive=True)
    except psutil.Error:
        return ()
    fingerprints: dict[int, ProcessFingerprint] = {}
    for child in children:
        fingerprint = process_fingerprint(int(child.pid))
        if fingerprint is not None:
            fingerprints[fingerprint.pid] = fingerprint
    return tuple(fingerprints[pid] for pid in sorted(fingerprints, reverse=True))


def _merge_fingerprints(
    *groups: tuple[ProcessFingerprint, ...],
) -> tuple[ProcessFingerprint, ...]:
    merged: dict[int, ProcessFingerprint] = {}
    for group in groups:
        for fingerprint in group:
            merged[fingerprint.pid] = fingerprint
    return tuple(merged[pid] for pid in sorted(merged, reverse=True))


def _terminate_captured_processes(
    fingerprints: tuple[ProcessFingerprint, ...],
    *,
    timeout_s: float = 5.0,
) -> dict[str, Any]:
    report: dict[str, Any] = {
        "captured": len(fingerprints),
        "terminate_requested": [],
        "killed": [],
        "skipped_identity_mismatch": [],
        "errors": [],
    }
    processes: list[psutil.Process] = []
    expected_by_pid = {item.pid: item for item in fingerprints}
    for fingerprint in fingerprints:
        if not fingerprint_matches(fingerprint):
            report["skipped_identity_mismatch"].append(fingerprint.pid)
            continue
        try:
            process = psutil.Process(fingerprint.pid)
            process.terminate()
            processes.append(process)
            report["terminate_requested"].append(fingerprint.pid)
        except psutil.Error as exc:
            report["errors"].append(
                f"{fingerprint.pid}:terminate:{type(exc).__name__}:{exc}"
            )
    if processes:
        _, alive = psutil.wait_procs(processes, timeout=max(0.0, timeout_s))
        for process in alive:
            fingerprint = expected_by_pid.get(int(process.pid))
            if fingerprint is None or not fingerprint_matches(fingerprint):
                report["skipped_identity_mismatch"].append(int(process.pid))
                continue
            try:
                process.kill()
                report["killed"].append(int(process.pid))
            except psutil.Error as exc:
                report["errors"].append(
                    f"{process.pid}:kill:{type(exc).__name__}:{exc}"
                )
    report["ok"] = not report["errors"]
    return report
''',
)
