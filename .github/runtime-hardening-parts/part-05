def handle(tmp_path: Path, managed: bool) -> WorkerHandle:
    root = tmp_path / str(managed)
    root.mkdir()
    model = root / "model.json"
    model.write_text("{}", encoding="utf-8")
    fingerprint = ProcessFingerprint(456, 1.0, 123, "C:/Aspen/apwn.exe")
    return WorkerHandle(
        1,
        Process(),
        Connection(),
        model,
        {"process_supervision": {"managed": managed}},
        owned_descendants=(fingerprint,),
    )


def test_parent_fallback_cleanup_is_identity_gated_and_reported(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    captured: list[tuple[ProcessFingerprint, ...]] = []
    monkeypatch.setattr(worker_module, "_capture_descendant_fingerprints", lambda p: ())
    monkeypatch.setattr(
        worker_module,
        "_terminate_process",
        lambda p: setattr(p, "alive", False),
    )

    def cleanup(values: tuple[ProcessFingerprint, ...], **kwargs: Any) -> dict[str, Any]:
        del kwargs
        captured.append(values)
        return {
            "captured": len(values),
            "terminate_requested": [item.pid for item in values],
            "killed": [],
            "skipped_identity_mismatch": [],
            "errors": [],
            "ok": True,
        }

    monkeypatch.setattr(worker_module, "_terminate_captured_processes", cleanup)
    unmanaged = worker_module._terminate_handle(handle(tmp_path, False))
    managed = worker_module._terminate_handle(handle(tmp_path, True))
    assert unmanaged["terminate_requested"] == [456]
    assert unmanaged["fallback_required"] is True
    assert managed["fallback_required"] is False
    assert len(captured) == 1


def test_timeout_result_contains_parent_cleanup(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    cleanup = {"job_object_managed": False, "fallback_required": True, "ok": True}
    monkeypatch.setattr(worker_module, "_terminate_handle", lambda item: cleanup)
    result = evaluate_on_worker(
        handle(tmp_path, False),
        EvaluationRequest.from_dict(request(timeout_s=0.01)),
    )
    assert result.violations == ["worker_timeout"]
    assert result.diagnostics["parent_process_cleanup"] == cleanup
