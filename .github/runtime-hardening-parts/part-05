
def test_mcp_mock_requires_explicit_allowed_roots(tmp_path: Path) -> None:
    with pytest.raises(PolicyError, match="requires ASPENOPS_ALLOWED_ROOTS"):
        build_server(settings=Settings(state_dir=tmp_path / "state"), start_scheduler=False)
    server = build_server(
        settings=Settings(
            allowed_roots=(tmp_path.resolve(),),
            state_dir=tmp_path / "state",
        ),
        start_scheduler=False,
    )
    assert server is not None


class Case:
    def __init__(self) -> None:
        self.closed: list[bool] = []
        self.Visible = False

    def Close(self, save: bool) -> None:
        self.closed.append(save)


class Cases:
    def __init__(self, value: Case | BaseException) -> None:
        self.value = value
        self.opened: list[str] = []

    def Open(self, path: str) -> Case:
        self.opened.append(path)
        if isinstance(self.value, BaseException):
            raise self.value
        return self.value


class Application:
    def __init__(self, value: Case | BaseException) -> None:
        self.SimulationCases = Cases(value)
        self.Visible = False
        self.quit_calls = 0

    def Quit(self) -> None:
        self.quit_calls += 1


def test_hysys_reinitialize_reopens_staged_case_and_taints_failure(tmp_path: Path) -> None:
    staged = tmp_path / "case.hsc"
    staged.write_text("case", encoding="utf-8")
    old = Case()
    new = Case()
    app = Application(new)
    backend = HysysBackend()
    backend.application = app
    backend.case = old
    backend.model_path = staged
    backend.visible = True
    backend.reinitialize()
    assert old.closed == [False]
    assert app.SimulationCases.opened == [str(staged)]
    assert backend.case is new
    assert new.Visible is True
    assert backend.reopen_count == 1

    failed = Application(RuntimeError("open failed"))
    backend.application = failed
    backend.case = old
    with pytest.raises(BackendStateError, match="Unable to reopen staged HYSYS case"):
        backend.reinitialize()
    assert backend.case is None
    assert backend.application is None


class FailedReset(SimulatorBackend):
    name = "mock"

    def open(self, model_path: Path, *, visible: bool = False) -> None:
        del model_path, visible

    def close(self) -> None:
        return None

    def reinitialize(self) -> None:
        raise BackendStateError("cannot restore")

    def write(self, node: Any, value: Any) -> None:
        del node, value

    def read(self, node: Any) -> Any:
        del node
        return 0

    def run(self) -> dict[str, Any]:
        raise AssertionError("unreachable")

    def runtime_identity(self) -> dict[str, Any]:
        return {"backend": "mock"}


def test_backend_state_error_marks_worker_tainted() -> None:
    plan = EvaluationPlan((), (), (), (), (), {}, IOEstimate(0, 0, 0, 0, 0))
    result = evaluate(
        FailedReset(),
        object(),  # type: ignore[arg-type]
        EvaluationRequest.from_dict(request()),
        plan=plan,
    )
    assert result.violations == ["backend_state_invalid"]
    assert result.diagnostics["worker_tainted"] is True


