from __future__ import annotations

from typing import Any, cast

from .research_common import (
    IssueSeverity,
    Maturity,
    ObjectRef,
    _LIFECYCLE_RANK,
    _MATURITY_RANK,
)
from .research_document import (
    ResearchIssue,
    ResearchStudyDocument,
    ResearchValidationReport,
)
from .research_objects import (
    Assumption,
    Dataset,
    Parameter,
    Target,
    Validation,
)


def validate_document(document: ResearchStudyDocument) -> ResearchValidationReport:
    objects = document._objects()
    issues: list[ResearchIssue] = []

    def add(
        severity: IssueSeverity,
        code: str,
        message: str,
        ref: ObjectRef | None = None,
        path: str | None = None,
    ) -> None:
        issues.append(
            ResearchIssue(
                severity=severity,
                code=code,
                message=message,
                object_ref=ref,
                path=path,
            )
        )

    def resolve(ref: ObjectRef, *, owner: ObjectRef, path: str) -> Any | None:
        value = objects.get((ref.object_type, ref.object_id))
        if value is None:
            add(
                "error",
                "unresolved_reference",
                f"Reference does not resolve: {ref.object_type}:{ref.object_id}",
                owner,
                path,
            )
        return value

    all_nonstudy = {key for key in objects if key[0] != "study"}
    declared = {(item.object_type, item.object_id) for item in document.study.object_refs}
    missing_declarations = sorted(all_nonstudy - declared)
    extra_declarations = sorted(declared - all_nonstudy)
    for object_type, object_id in missing_declarations:
        add(
            "error",
            "study_missing_object_ref",
            f"Study does not reference {object_type}:{object_id}",
            ObjectRef("study", document.study.study_id),
            "study.object_refs",
        )
    for object_type, object_id in extra_declarations:
        add(
            "error",
            "study_unresolved_object_ref",
            f"Study references missing {object_type}:{object_id}",
            ObjectRef("study", document.study.study_id),
            "study.object_refs",
        )

    datasets_by_id = {item.dataset_id: item for item in document.datasets}
    targets_by_id = {item.target_id: item for item in document.targets}
    parameters_by_id = {item.parameter_id: item for item in document.parameters}
    assumptions_by_id = {item.assumption_id: item for item in document.assumptions}
    calibrations_by_id = {item.calibration_id: item for item in document.calibrations}
    validations_by_id = {item.validation_id: item for item in document.validations}

    for target in document.targets:
        owner = ObjectRef("target", target.target_id)
        if target.dataset_binding is not None:
            dataset = datasets_by_id.get(target.dataset_binding.dataset_id)
            if dataset is None:
                add(
                    "error",
                    "target_dataset_missing",
                    f"Target dataset does not exist: {target.dataset_binding.dataset_id}",
                    owner,
                    "target.dataset_binding",
                )
            elif target.dataset_binding.variable not in {
                item.name for item in dataset.variables
            }:
                add(
                    "error",
                    "target_variable_missing",
                    f"Dataset variable does not exist: {target.dataset_binding.variable}",
                    owner,
                    "target.dataset_binding.variable",
                )
        for index, dependency in enumerate(target.dependencies):
            resolve(
                dependency,
                owner=owner,
                path=f"target.dependencies[{index}]",
            )

    for assumption in document.assumptions:
        owner = ObjectRef("assumption", assumption.assumption_id)
        for index, affected in enumerate(assumption.affected_objects):
            resolve(
                affected,
                owner=owner,
                path=f"assumption.affected_objects[{index}]",
            )
        if assumption.category == "source_contradiction" and not assumption.contradiction_group:
            add(
                "error",
                "contradiction_group_required",
                "Source contradiction assumptions require contradiction_group",
                owner,
                "assumption.contradiction_group",
            )
        if assumption.status in {"rejected", "superseded"} and assumption.resolution is None:
            add(
                "warning",
                "assumption_resolution_missing",
                "Rejected or superseded assumption should record its resolution",
                owner,
                "assumption.resolution",
            )

    calibration_dataset_ids: set[str] = set()
    validation_dataset_ids: set[str] = set()
    for calibration in document.calibrations:
        owner = ObjectRef("calibration", calibration.calibration_id)
        estimated_count = 0
        for index, ref in enumerate(calibration.dataset_refs):
            dataset = resolve(
                ref,
                owner=owner,
                path=f"calibration.dataset_refs[{index}]",
            )
            if ref.object_type != "dataset":
                add(
                    "error",
                    "calibration_dataset_type",
                    "Calibration dataset_refs must reference Dataset objects",
                    owner,
                    f"calibration.dataset_refs[{index}]",
                )
            elif isinstance(dataset, Dataset):
                calibration_dataset_ids.add(dataset.dataset_id)
                if dataset.role != "calibration":
                    add(
                        "error",
                        "calibration_dataset_role",
                        f"Calibration uses Dataset with role={dataset.role}",
                        owner,
                        f"calibration.dataset_refs[{index}]",
                    )
        for index, ref in enumerate(calibration.target_refs):
            target = resolve(
                ref,
                owner=owner,
                path=f"calibration.target_refs[{index}]",
            )
            if ref.object_type != "target" or not isinstance(target, Target):
                add(
                    "error",
                    "calibration_target_type",
                    "Calibration target_refs must reference Target objects",
                    owner,
                    f"calibration.target_refs[{index}]",
                )
            elif target.role not in {"fit", "acceptance", "diagnostic"}:
                add(
                    "error",
                    "calibration_target_role",
                    f"Calibration cannot use Target with role={target.role}",
                    owner,
                    f"calibration.target_refs[{index}]",
                )
